# ── Provider selection ──────────────────────────────────────────────────────
# 'anthropic' (default) or 'openai' (any OpenAI-compatible endpoint)
AI_PROVIDER=anthropic

# ── Credentials & endpoint ───────────────────────────────────────────────────
AI_API_KEY=your-key-here

# Optional: override the base URL — use this for proxies, LiteLLM, Ollama,
# Azure OpenAI, or any other OpenAI-compatible service.
# Examples:
#   AI_BASE_URL=http://localhost:11434/v1          # Ollama
#   AI_BASE_URL=https://litellm.example.com        # LiteLLM proxy
#   AI_BASE_URL=https://api.openai.com/v1          # OpenAI (default for openai provider)
# AI_BASE_URL=

# ── Model ────────────────────────────────────────────────────────────────────
# Defaults: claude-sonnet-4-6 (anthropic), gpt-4o (openai)
# AI_MODEL=claude-sonnet-4-6

# ── Limits ───────────────────────────────────────────────────────────────────
# AI_MAX_TOKENS=8192

# ── Skills directory ─────────────────────────────────────────────────────────
# Defaults to ../skills relative to web/ when running locally.
# Set explicitly if running from a different working directory.
# SKILLS_ROOT=/absolute/path/to/skills
